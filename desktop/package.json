{
  "name": "pm-sim",
  "version": "1.2.1",
  "description": "PM-SIM: educational patient monitor simulator",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Hafij-BGE",
    "email": "mdhafijur.rahman@ogr.deu.edu.tr"
  },
  "homepage": "https://hafij-bge.github.io/patient-monitoring/",
  "main": "main.cjs",
  "desktopName": "pm-sim.desktop",
  "devDependencies": {
    "electron": "42.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.hafijbge.pmsim",
    "productName": "PM-SIM",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "icon.png", "web/**"],
    "linux": {
      "target": ["deb"],
      "icon": "icon.png",
      "category": "Education",
      "maintainer": "Hafij-BGE <mdhafijur.rahman@ogr.deu.edu.tr>",
      "synopsis": "Educational patient monitor simulator",
      "description": "Simulates a multiparameter bedside monitor (ECG, pulse oximetry, invasive and non-invasive blood pressure, capnography, respiration, temperature) for teaching. Not a medical device.",
      "artifactName": "PM-SIM-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "deb": { "packageCategory": "education" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "icon": "icon.png",
      "artifactName": "PM-SIM-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PM-SIM-${version}-setup-${arch}.${ext}",
      "shortcutName": "PM-SIM"
    },
    "portable": { "artifactName": "PM-SIM-${version}-portable-${arch}.${ext}" }
  }
}
